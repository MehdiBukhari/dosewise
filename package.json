{
  "name": "dosewise",
  "version": "0.1.0",
  "private": true,
  "description": "Dosewise — a medication-safety MCP server for Alexa+, with a browser-based Alexa+ experience simulator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "tsx tests/mcp-smoke.ts",
    "demo:timeline": "node scripts/build-demo-timeline.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:assemble": "node scripts/assemble-video.mjs",
    "demo": "npm run demo:timeline && npm run demo:record && npm run demo:assemble"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
